# ==============================================================================
# AllocFlow Root .gitignore
# ==============================================================================

# OS files
.DS_Store
Thumbs.db

# IDE and Editor files
.idea/
*.iml
.vscode/
*.swp
*.swo

# Java & Maven build artifacts
**/target/
**/*.class
**/*.jar
**/*.war
**/*.ear
**/*.nar
**/*.zip
**/*.tar.gz
**/*.rar
hs_err_pid*
replay_pid*

# Node & Next.js build artifacts
**/node_modules/
**/.next/
**/out/
**/build/
**/dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.turbo/
*.tsbuildinfo

# Environment & Secrets
.env
.env*.local
*.pem
*.key

# Database / Storage files
*.sqlite
*.sqlite3
*.db
pgdata/
